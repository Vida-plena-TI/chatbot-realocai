# Copie para `.env` na raiz do repositório e preencha os valores.
# NUNCA commite o arquivo `.env`.

# --- Django ---
# Obs.: o módulo de settings NÃO é lido daqui. manage.py usa config.settings.dev e
# wsgi/asgi usam config.settings.prod; para trocar, exporte DJANGO_SETTINGS_MODULE no shell.
# Gere com: uv run python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=change-me
# true apenas em desenvolvimento (prod.py força False)
DEBUG=true
# Lista separada por vírgulas
ALLOWED_HOSTS=localhost,127.0.0.1
# Nível de log: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# --- Banco de dados (Supabase / PostgreSQL) ---
# Supabase > Project Settings > Database > Connection string > "Session pooler".
# Formato: postgres://postgres.<PROJECT_REF>:<SENHA>@aws-0-<REGIAO>.pooler.supabase.com:5432/postgres
# Não use o "Transaction pooler" (porta 6543): ele é incompatível com conexões persistentes do Django.
# Se a senha tiver caracteres especiais (@ : / # ?), codifique-os em URL (ex.: @ -> %40).
DATABASE_URL=postgres://postgres.your-project-ref:change-me@aws-0-sa-east-1.pooler.supabase.com:5432/postgres
# Modo SSL do libpq: require (padrão), verify-full, ou disable (apenas Postgres local sem TLS)
DB_SSLMODE=require
# Tempo (s) de reuso de conexões; 0 desativa
CONN_MAX_AGE=60

# --- CORS / CSRF ---
# Origens do frontend autorizadas a chamar a API com cookies (lista separada por vírgulas,
# com esquema). Só necessário quando o frontend roda em outra origem (ex.: Vite em dev).
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Origens confiáveis para requisições POST/PUT/DELETE com CSRF (lista separada por vírgulas,
# com esquema). Em produção, a origem pública do app (ex.: https://app.exemplo.com.br).
# Em dev, inclua a origem do Vite se ele fizer proxy para a API (ex.: http://localhost:5173).
CSRF_TRUSTED_ORIGINS=

# --- RealocAI (serviço do agente de IA, FastAPI em outro repositório) ---
# Chamado apenas servidor-a-servidor: a chave NUNCA vai para o navegador.
# Em dev, o `runserver` do Django já ocupa a porta 8000: suba o RealocAI em outra porta
# (ex.: `uvicorn ... --port 8001`) e aponte para ela.
REALOCAI_BASE_URL=http://localhost:8001
# Chave enviada no header X-API-Key. Peça ao responsável pelo RealocAI; nunca commite.
REALOCAI_API_KEY=change-me
# Tempo máximo (s) de leitura da resposta; o agente faz várias chamadas ao modelo.
# A conexão tem timeout próprio de 5 s. Em produção, o --timeout do gunicorn precisa
# ser maior que este valor (ex.: 120); ver "Deploy" no README.
REALOCAI_TIMEOUT_SECONDS=90
# Só para desenvolvimento/demonstração: true responde com textos fixos e blocos de
# relatório de exemplo, sem chamar o RealocAI (não precisa de URL nem chave).
REALOCAI_USE_FAKE=false
# EXPERIMENTAL — mantenha false até validação manual (ver CLAUDE.md).
# Com true, ao abrir uma conversa nova no RealocAI (primeira mensagem ou reinício após
# expirar), a mensagem enviada ganha um prefixo com o resumo da conversa e as memórias
# do profissional.
REALOCAI_INJECT_MEMORIES=false

# --- Chat e relatórios ---
# Tamanho máximo (caracteres) de uma mensagem enviada pelo usuário.
MESSAGE_MAX_LENGTH=2000
# Tamanho máximo (bytes) do corpo aceito por POST /api/reports/export/ (padrão 2 MB).
REPORTS_EXPORT_MAX_BYTES=2097152
# O admin mostra só metadados das mensagens (seq, papel, data, tamanho). true exibe o
# conteúdo (dados de saúde): ligue apenas quando houver necessidade justificada.
ADMIN_SHOW_MESSAGE_CONTENT=false

# --- OpenAI (extração de memórias de longo prazo) ---
# Usada diretamente pelo Django SÓ para extrair memórias/resumo após cada mensagem
# (o chat em si continua passando pelo RealocAI). Segredo: nunca commite.
# Vazia = extração desligada (o chat funciona normalmente).
OPENAI_API_KEY=
# Modelo usado na extração (precisa suportar Structured Outputs)
OPENAI_EXTRACTION_MODEL=gpt-4o-mini

# --- Proxy ---
# Quantidade de proxies reversos confiáveis na frente do app (nginx, load balancer).
# Usado pelo throttling para obter o IP real do cliente via X-Forwarded-For.
# Deixe comentado quando não houver proxy (usa REMOTE_ADDR); não defina como vazio.
# NUM_PROXIES=1

# --- Segurança (apenas produção; valores padrão já são seguros) ---
# Desative somente se o proxy já redireciona HTTP -> HTTPS
SECURE_SSL_REDIRECT=true
# Duração do HSTS em segundos (padrão: 1 ano)
SECURE_HSTS_SECONDS=31536000
# Ative apenas após confirmar HTTPS em todos os subdomínios
SECURE_HSTS_PRELOAD=false
