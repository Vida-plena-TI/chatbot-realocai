# Variáveis VITE_* vão para o bundle do navegador: são PÚBLICAS, nunca coloque segredos.
# Na imagem Docker (Easypanel) elas são build args e têm prioridade sobre .env.production;
# o build falha se VITE_USE_MOCK != false ou se VITE_API_BASE_URL não for https://.
# Ver docs/deploy-easypanel.md.

# URL base da API Django (sem barra no final).
# Deixe vazio para usar a mesma origem do front (ex.: com VITE_PROXY_TARGET).
# Produção: https://api-chat.vidaplenamulti.com.br
VITE_API_BASE_URL=http://localhost:8000

# true = usa o mock local (src/api/mock). false = chama a API real. Produção: false.
VITE_USE_MOCK=true

# Opcional, só no `npm run dev`: encaminha /api para o Django.
# Use junto com VITE_API_BASE_URL vazio.
# VITE_PROXY_TARGET=http://localhost:8000
